# Copy this file to .env.local for local testing:
#   docker compose --env-file .env.local up -d --build

POSTGRES_DB=shortener
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=devpassword

DATABASE_URL=postgresql://app_admin:devpassword@postgres:5432/shortener

# Leave blank locally, the backend falls back to the incoming request's host.
APP_BASE_URL=

# Caddy will not get a real certificate for "localhost", it just serves
# over plain HTTP locally, which is fine for a sanity check.
DOMAIN=localhost
